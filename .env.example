# Gauntlet — environment template. Copy to .env.local and fill.
# THE DEMO RUNS WITHOUT ANY OF THESE — it is offline by default.

# Live, model-generated attacker (implemented in lib/attacker.ts). Set GAUNTLET_LIVE=true + a key,
# then run `npm run dev:live` — it force-loads this file (some shells export an empty
# ANTHROPIC_API_KEY that would otherwise shadow it). Any error falls back to the offline corpus.
GAUNTLET_LIVE=false
# ANTHROPIC_API_KEY=sk-ant-...      # or OPENAI_API_KEY
# GAUNTLET_MODEL=claude-haiku-4-5-20251001

# Persistence for runs/findings (planned — Backend workstream).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
